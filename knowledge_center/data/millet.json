  {
    "crop": "谷子",
    "disease": "谷子白发病",
    "aliases": [
      "白发病",
      "灰背",
      "枪杆",
      "看谷老",
      "刺猬头"
    ],
    "risk_level": "高",
    "growth_stage": [
      "幼苗期",
      "生长期"
    ],
    "symptoms": [
      "苗期3-4叶时叶正面出现黄白色条纹，叶背密布灰白色霉层（灰背）",
      "心叶不能抽出展开，呈黄白色直立于顶端（白尖）",
      "病株心叶散出大量黄褐色粉末，残留白色维管束卷曲成乱发状（白发）",
      "抽穗后病穗短缩肥肿、不能结实，呈刺猬状直立（看谷老）"
    ],
    "favorable_conditions": [
      "播种后地温低、种子出土萌发时间长",
      "后期多雨高温",
      "地势低洼、通风透光差"
    ],
    "diagnosis_features": [
      "系统性侵染，主要通过土壤传播",
      "谷子萌发至出土前最易被侵染，形成死芽、死苗、灰背、枪杆、白发、刺猬头",
      "叶背灰白色霉层与卷曲乱发状维管束是典型识别特征"
    ],
    "prevention": [
      "选用抗病品种并定期更换，避免多年连种同一品种导致抗性丧失",
      "种子包衣或拌种处理",
      "及时拔除灰背、白尖、枪杆、刺猬头等病株，带出田外烧毁或深埋",
      "发病严重地块实行三年以上轮作"
    ],
    "chemical_control": [
      "甲霜灵",
      "精甲霜灵"
    ],
    "keywords": [
